---
import { isImagePath } from '../../utils/media';
import { organization, person } from './identity';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	readingTime?: string;
	body?: string;
	url?: URL;
	// Google's Article rich results only accept these three types.
	type?: 'BlogPosting' | 'Article' | 'NewsArticle';
	articleSection?: string;
	keywords?: string[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	readingTime,
	body,
	url,
	type = 'BlogPosting',
	articleSection = 'CSS',
	keywords,
} = Astro.props as Props;

const pageUrl = url ?? new URL(Astro.url.pathname, Astro.site);
// Same fallback as the og:image in BaseHead.
const imageUrl = new URL(isImagePath(heroImage) ? heroImage : '/sharing.png', Astro.site);

// Convert "9 min read" → ISO 8601 duration "PT9M"
const parseTimeRequired = (rt?: string): string | undefined => {
	if (!rt) return undefined;
	const match = rt.match(/(\d+)\s*min/i);
	return match ? `PT${match[1]}M` : undefined;
};
const timeRequired = parseTimeRequired(readingTime);

// Approx word count from raw body, when available.
const wordCount = body
	? body
			.replace(/```[\s\S]*?```/g, '') // strip fenced code
			.replace(/<[^>]+>/g, ' ') // strip JSX/html tags
			.replace(/[#>*_`~\-]/g, ' ')
			.split(/\s+/)
			.filter(Boolean).length
	: undefined;

const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': type,
	headline: title,
	description,
	datePublished: pubDate,
	dateModified: updatedDate ?? pubDate,
	url: pageUrl,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
	isPartOf: {
		'@type': 'Blog',
		name: 'Theo Soti',
		url: import.meta.env.SITE,
	},
	inLanguage: 'en',
	articleSection,
	author: person,
	publisher: organization,
	image: {
		'@type': 'ImageObject',
		caption: title,
		url: imageUrl,
	},
	speakable: {
		'@type': 'SpeakableSpecification',
		cssSelector: ['h1', 'article p:first-of-type', '.prose h2'],
	},
};

if (timeRequired) structuredData.timeRequired = timeRequired;
if (wordCount) structuredData.wordCount = wordCount;
if (keywords && keywords.length > 0) structuredData.keywords = keywords;
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
