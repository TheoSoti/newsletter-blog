---
import { homeUrl, organization, person } from './identity';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${homeUrl}#website`,
			name: 'Theo Soti',
			url: homeUrl,
			description: 'Modern CSS tutorials and frontend development insights by Theo Soti.',
			inLanguage: 'en',
			author: { '@id': person['@id'] },
			publisher: { '@id': organization['@id'] },
		},
		organization,
		person,
	],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
