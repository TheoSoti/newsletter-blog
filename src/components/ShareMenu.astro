---
import { ShareNetworkIcon } from '@phosphor-icons/react/ssr';

interface Props {
	title: string;
	url: string;
	kind?: 'article' | 'short';
}

const { title, url, kind = 'article' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const popoverId = `share-${kind}`;
---

<div class="share-menu">
	<button
		class="share-trigger button"
		type="button"
		popovertarget={popoverId}
	>
		<ShareNetworkIcon size={20} weight="bold" />
		Share
	</button>

	<div id={popoverId} class="share-popover" popover="auto">
		<a
			href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
			target="_blank"
			rel="noopener noreferrer"
		>
			X (Twitter)
		</a>
		<a
			href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
			target="_blank"
			rel="noopener noreferrer"
		>
			Facebook
		</a>
		<a
			href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
			target="_blank"
			rel="noopener noreferrer"
		>
			LinkedIn
		</a>
		<a href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}>Email</a>
	</div>
</div>

<style>
	.share-menu {
		display: flex;
		justify-content: center;
		margin-top: 1rem;
	}

	.share-trigger {
		anchor-name: --share-trigger;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 92px;
		min-height: 44px;
		padding: 0.4rem 0.9rem;
		font: inherit;
		font-size: 0.9rem;
		line-height: 1;
		touch-action: manipulation;
	}

	.share-popover {
		position: fixed;
		inset: calc(80px + 0.75rem) auto auto 50%;
		width: min(230px, calc(100vw - 2rem));
		max-height: calc(100dvh - 80px - 1.5rem);
		margin: 0;
		padding: 0.45rem;
		border: 2px solid var(--border);
		border-radius: 6px;
		background: var(--bg-light);
		box-shadow: var(--box-shadow);
		color: var(--text);
		opacity: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		scale: 0.97;
		translate: 0 -6px;
		transform: translateX(-50%);
		transition:
			opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
			scale 160ms cubic-bezier(0.16, 1, 0.3, 1),
			translate 160ms cubic-bezier(0.16, 1, 0.3, 1),
			display 160ms allow-discrete,
			overlay 160ms allow-discrete;
	}

	.share-popover:popover-open {
		opacity: 1;
		scale: 1;
		translate: 0;
	}

	@starting-style {
		.share-popover:popover-open {
			opacity: 0;
			scale: 0.97;
			translate: 0 -6px;
		}
	}

	.share-popover a {
		display: flex;
		align-items: center;
		width: 100%;
		min-height: 44px;
		padding: 0.55rem 0.75rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 650;
		line-height: 1.2;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		touch-action: manipulation;
		transition:
			background-color 120ms ease,
			color 120ms ease,
			transform 120ms ease;
	}

	.share-popover a:hover,
	.share-popover a:focus-visible {
		background: var(--main);
		color: var(--black);
		transform: translateX(3px);
	}

	@supports (position-anchor: --share-trigger) {
		.share-popover {
			position: fixed;
			position-anchor: --share-trigger;
			inset: auto;
			position-area: bottom center;
			margin-block-start: 0.7rem;
			transform: none;
			position-try: flip-block;
			position-try-fallbacks: flip-block;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.share-trigger,
		.share-popover,
		.share-popover a {
			transition-duration: 0.01ms;
		}

		.share-popover,
		.share-popover:popover-open {
			scale: 1;
			translate: 0;
		}

		.share-popover a:hover,
		.share-popover a:focus-visible {
			transform: none;
		}
	}
</style>
