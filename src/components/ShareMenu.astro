---
import { ShareNetworkIcon } from '@phosphor-icons/react/ssr';

interface Props {
	title: string;
	url: string;
	kind?: 'article' | 'short';
}

const { title, url, kind = 'article' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const popoverId = `share-${kind}`;
const shareLabel = kind === 'short' ? 'short article' : 'article';
---

<div class="share-menu">
	<button
		class="share-trigger button"
		type="button"
		aria-controls={popoverId}
		aria-expanded="false"
		aria-label={`Share this ${shareLabel}`}
	>
		<ShareNetworkIcon size={20} weight="bold" aria-hidden="true" />
		Share
	</button>

	<div
		id={popoverId}
		class="share-popover"
		role="group"
		aria-label={`Share this ${shareLabel}`}
		hidden
	>
		<a
			href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
			target="_blank"
			rel="noopener noreferrer"
			data-share-link
		>
			X (Twitter)
		</a>
		<a
			href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
			target="_blank"
			rel="noopener noreferrer"
			data-share-link
		>
			Facebook
		</a>
		<a
			href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
			target="_blank"
			rel="noopener noreferrer"
			data-share-link
		>
			LinkedIn
		</a>
		<button type="button" data-share-copy data-share-url={url}>Copy link</button>
		<span class="sr-only" aria-live="polite" data-share-status></span>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.share-menu').forEach((shareMenu) => {
		const trigger = shareMenu.querySelector<HTMLButtonElement>('.share-trigger');
		const popover = shareMenu.querySelector<HTMLElement>('.share-popover');
		if (!trigger || !popover) return;

		const setOpen = (open: boolean) => {
			popover.hidden = !open;
			trigger.setAttribute('aria-expanded', String(open));
		};

		trigger.addEventListener('click', () => setOpen(popover.hidden));

		popover.querySelectorAll<HTMLAnchorElement>('[data-share-link]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('pointerdown', (event) => {
			if (
				!popover.hidden &&
				event.target instanceof Node &&
				!shareMenu.contains(event.target)
			) {
				setOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !popover.hidden) {
				setOpen(false);
				trigger.focus();
			}
		});

		const copyButton = popover.querySelector<HTMLButtonElement>('[data-share-copy]');
		const status = popover.querySelector<HTMLElement>('[data-share-status]');

		copyButton?.addEventListener('click', async () => {
			const shareUrl = copyButton.dataset.shareUrl;
			if (!shareUrl) return;

			try {
				await navigator.clipboard.writeText(shareUrl);
				copyButton.textContent = 'Copied!';
				if (status) status.textContent = 'Link copied to clipboard.';
				window.setTimeout(() => {
					copyButton.textContent = 'Copy link';
				}, 1800);
			} catch {
				copyButton.textContent = 'Copy failed';
				if (status) status.textContent = 'The link could not be copied.';
				window.setTimeout(() => {
					copyButton.textContent = 'Copy link';
				}, 1800);
			}
		});
	});
</script>

<style>
	.share-menu {
		position: relative;
		z-index: 20;
		display: flex;
		justify-content: center;
		margin-top: 1rem;
	}

	.share-trigger {
		anchor-name: --share-trigger;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 92px;
		min-height: 44px;
		padding: 0.4rem 0.9rem;
		font: inherit;
		font-size: 0.9rem;
		line-height: 1;
		touch-action: manipulation;
	}

	.share-popover {
		position: absolute;
		z-index: 20;
		top: calc(100% + 0.7rem);
		left: 50%;
		width: min(230px, calc(100vw - 2rem));
		max-height: calc(100dvh - 80px - 1.5rem);
		margin: 0;
		padding: 0.45rem;
		border: 2px solid var(--border);
		border-radius: 6px;
		background: var(--bg-light);
		box-shadow: var(--box-shadow);
		color: var(--text);
		opacity: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		scale: 1;
		translate: 0;
		transform: translateX(-50%);
		transition:
			opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
			scale 160ms cubic-bezier(0.16, 1, 0.3, 1),
			translate 160ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.share-popover[hidden] {
		display: none;
	}

	@starting-style {
		.share-popover:not([hidden]) {
			opacity: 0;
			scale: 0.97;
			translate: 0 -6px;
		}
	}

	.share-popover a,
	.share-popover button {
		display: flex;
		align-items: center;
		width: 100%;
		min-height: 44px;
		padding: 0.55rem 0.75rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 650;
		line-height: 1.2;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		touch-action: manipulation;
		transition:
			background-color 120ms ease,
			color 120ms ease,
			transform 120ms ease;
	}

	.share-popover a:hover,
	.share-popover a:focus-visible,
	.share-popover button:hover,
	.share-popover button:focus-visible {
		background: var(--main);
		color: var(--black);
		transform: translateX(3px);
	}

	@supports (position-anchor: --share-trigger) {
		.share-popover {
			position: fixed;
			position-anchor: --share-trigger;
			inset: auto;
			top: calc(anchor(bottom) + 0.7rem);
			left: anchor(center);
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.share-trigger,
		.share-popover,
		.share-popover a,
		.share-popover button {
			transition-duration: 0.01ms;
		}

		.share-popover {
			scale: 1;
			translate: 0;
		}

		.share-popover a:hover,
		.share-popover a:focus-visible,
		.share-popover button:hover,
		.share-popover button:focus-visible {
			transform: none;
		}
	}
</style>
