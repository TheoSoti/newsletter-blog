---
interface Props {
	width: string;
	height?: string;
	quantity?: number;
	icon: 'sparkle' | 'starburst';
}

const { width, height = '68px', quantity = 7, icon } = Astro.props;
const items = Array.from({ length: quantity });
const copies = Array.from({ length: 2 });
---

<div class="slider" style={`--width: ${width}; --height: ${height}; --quantity: ${quantity};`}>
	<div class="slider__container">
		<div class="list">
			{
				copies.map(() => (
					<div class="slider__group" aria-hidden="true">
						{items.map(() => (
							<div class="item">
								<span class={icon}></span>You don't need JS!
							</div>
						))}
					</div>
				))
			}
		</div>
	</div>
</div>
