---
import { Picture } from 'astro:assets';
import bookMockup from '../../assets/ebook/book-professional-transparent.png';
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero__container">
		<div class="hero__content">
			<p class="hero__title">You Don't Need JavaScript</p>
			<h1 class="hero__headline" id="hero-heading">
				<span class="hero__headline-line">Build interactive UI</span>
				<span class="hero__headline-line">with less JavaScript</span>
			</h1>
			<p class="hero__description hero__description--default">
				Learn how to replace unnecessary JavaScript with lightweight CSS components that load faster and are easier to maintain.
			</p>
			<p class="hero__description hero__description--csswind">
				Learn accessible CSS patterns you can adapt to Tailwind, plus when JavaScript is still the right choice.
			</p>
			<div class="hero__offer">
				<p class="hero__offer-title">Two editions</p>
				<ul class="hero__offer-list">
					<li><strong>Ebook:</strong> 125 pages with 27 step-by-step patterns</li>
					<li><strong>Bundle:</strong> adds 27 components, a CSS cheat sheet, and 100+ tools</li>
				</ul>
				<p class="hero__assurance">Both are instant downloads with lifetime updates and a 30-day refund.</p>
			</div>

			<div class="hero__actions">
				<a href="#pricing" class="button">Compare editions</a>
				<a href="/YDNJS-preview.pdf" class="hero__preview" target="_blank" rel="noopener">Read the free preview</a>
			</div>
		</div>
		<div class="hero__image">
			<div class="background"></div>
			<Picture
				src={bookMockup}
				formats={['avif', 'webp', 'png']}
				width="839"
				class="book"
				height="1268"
				alt="Hardcover mockup of You Don't Need JavaScript by Theo Soti"
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
		</div>
	</div>
</section>
