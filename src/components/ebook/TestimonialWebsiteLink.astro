---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="testimonial__website" href={href} target="_blank" rel="noopener" aria-label={label}>
	<svg
		aria-hidden="true"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M14 5h5v5"></path>
		<path d="m19 5-9 9"></path>
		<path d="M19 13v6H5V5h6"></path>
	</svg>
</a>

<style>
	.testimonial__website {
		position: absolute;
		inset-block-start: var(--pad-12-16);
		inset-inline-end: var(--pad-12-16);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 2px solid var(--border);
		border-radius: 6px;
		box-shadow: 4px 4px 0 0 rgba(0, 0, 0, 1);
		padding: 0.4rem 0.5rem;
		background-color: var(--white);
		color: var(--text);
		text-decoration: none;
		vertical-align: middle;
		touch-action: manipulation;
		transition-property: box-shadow, transform;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		transition-duration: 0.15s;
	}

	.testimonial__website:hover,
	.testimonial__website:focus {
		box-shadow: 0 0 var(--black);
		transform: translateY(6px);
	}

	svg {
		inline-size: 25px;
		block-size: 25px;
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial__website {
			transition: none;
		}
	}
</style>
