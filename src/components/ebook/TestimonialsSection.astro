---
import { Picture } from 'astro:assets';
import testimonial_utsav from '../../assets/ebook/utsav.png';
import testimonial_pierre from '../../assets/ebook/pierre.png';
import testimonial_virgile from '../../assets/ebook/virgile.png';
import testimonial_paul from '../../assets/ebook/paul.png';
import testimonial_lionel from '../../assets/ebook/lionel.png';
import testimonial_cedric from '../../assets/ebook/cedric.png';
import testimonial_joseph from '../../assets/ebook/joseph.png';
import TestimonialWebsiteLink from './TestimonialWebsiteLink.astro';

const testimonials = [
	{
		name: 'Utsav Meena',
		role: 'CSS Content Creator',
		image: testimonial_utsav,
		website: 'https://flexicajourney.com/',
		websiteLabel: 'Visit Utsav Meena’s website',
		quote:
			'It’s an easy-to-follow guide with everything explained step by step. I also liked the extra pointers on accessibility, troubleshooting, and browser compatibility. Hopefully, this will help people appreciate CSS a bit more.',
	},
	{
		name: 'Paul Wright',
		role: 'Full Stack Web Developer',
		image: testimonial_paul,
		website: 'https://www.suedeapple.co.uk/',
		websiteLabel: 'Visit Paul Wright’s website',
		quote:
			'Read this book and you’ll be gleefully ripping out half your JS before you’ve even finished the second chapter. You Don’t Need JavaScript is a breath of fresh air packed with “wait… CSS can do that?!” moments. Theo has a knack for making complex ideas feel effortless, proving that elegant, interactive design doesn’t always need a mountain of JS. It’s the perfect reminder that simplicity, speed, and creativity often live right there in your stylesheet.',
	},
	{
		name: 'Lionel Péramo',
		role: 'Fullstack Developer & Content Creator',
		image: testimonial_lionel,
		website: 'http://lionel-peramo.com/',
		websiteLabel: 'Visit Lionel Péramo’s website',
		quote:
			'Theo brilliantly shows how modern CSS can replace complex JavaScript without losing creativity or functionality. The examples are clear, practical, and inspiring. A refreshing reminder that the simplest tools often create the best results. A must-read for any developer.',
	},
	{
		name: 'Joseph',
		role: 'Acworth Web Designs LLC',
		image: testimonial_joseph,
		website: 'https://acworthwebdesigns.com/',
		websiteLabel: 'Visit Joseph’s Acworth Web Designs website',
		quote:
			'An important read for web designers in this era. Theo takes some of the most powerful new web features of the last few years & distills them into simple, immediately-useful examples. If you’re like me, you’ll be able to significantly reduce your JavaScript footprint overnight, while also improving the quality of your web pages.',
	},
	{
		name: 'Virgile Gouala',
		role: 'Engineering Manager',
		image: testimonial_virgile,
		website: 'https://goua.la/',
		websiteLabel: 'Visit Virgile Gouala’s website',
		quote:
			'You Don’t Need JavaScript introduced me to the “Rule of Least Power”, a principle that is both simple and profoundly enlightening. In a web world that’s always accelerating, this work promotes a more ecological, thoughtful, and handcrafted approach to development, reminding us that elegance and impact often arise from simplicity.',
	},
	{
		name: 'Cedric Molla',
		role: 'Web Developer',
		image: testimonial_cedric,
		quote:
			'Such a great read! It’s practical, easy to follow, and packed with smart ideas I can actually use. It made me want to revisit old projects and try a lighter, CSS-first approach.',
	},
	{
		name: 'Pierre Liegard',
		role: 'Front-end Developer',
		image: testimonial_pierre,
		quote:
			'This book offers a welcome reminder of the latest CSS developments at a time when performance matters more than ever.',
	},
];
---

<section class="testimonials" id="reviews" aria-labelledby="testimonials-title">
	<div class="testimonials__container">
		<header class="testimonials__intro">
			<h2 class="testimonials__title" id="testimonials-title">Loved by the community</h2>
			<p>What front-end developers took away from the book.</p>
		</header>

		<ul class="testimonial__list">
			{
				testimonials.map((testimonial) => (
					<li class="testimonial">
						<div class="testimonial__content">
							<Picture
								src={testimonial.image}
								formats={['avif', 'webp', 'jpg']}
								width="168"
								height="168"
								alt=""
								class="testimonial__image"
							/>
							<p class="testimonial__author">
								<span class="testimonial__name">
									{testimonial.name}
									{testimonial.website && testimonial.websiteLabel && (
										<TestimonialWebsiteLink href={testimonial.website} label={testimonial.websiteLabel} />
									)}
								</span>
								<span class="testimonial__role">{testimonial.role}</span>
							</p>
						</div>
						<blockquote class="testimonial__text">{testimonial.quote}</blockquote>
					</li>
				))
			}
		</ul>
	</div>
</section>
