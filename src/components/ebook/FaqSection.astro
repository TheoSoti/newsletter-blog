---
import { ebookFaqs } from '../../data/ebook';
---

<section class="faq" aria-labelledby="faq-title">
	<h2 class="faq__title" id="faq-title">Frequently asked questions</h2>

	<ul class="faq__container">
		{
				ebookFaqs.map((faq, index) => (
				<li class="accordion">
					<details name="book-faq" open={index === 0}>
						<summary>
							<span class="accordion__title">{faq.question}</span>
						</summary>

						<div class="content">
							<p>
								{'answerParts' in faq ? (
									faq.answerParts.map((part) =>
										'href' in part ? (
											<a href={part.href} target="_blank" rel="nofollow noopener">{part.text}</a>
										) : (
											part.text
										)
									)
								) : (
									faq.answer
								)}
							</p>
						</div>
					</details>
				</li>
			))
		}
	</ul>
</section>
